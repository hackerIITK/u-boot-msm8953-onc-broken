	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xff08 0x01 0x03 0xff08 0x01 0x04 0xff08 0x01 0x01 0xff08>;
	};

	aliases {
		mmc0 = "/soc@0/mmc@7824900";
		mmc1 = "/soc@0/mmc@7864900";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xc6>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <0x39 0x55 0x01>;
			linux,code = <0x73>;
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x32>;
	};
};
